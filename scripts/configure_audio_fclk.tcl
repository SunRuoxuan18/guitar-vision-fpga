# Configure only FCLK0 on an already initialized PYNQ-Z2 PS.
# Do not run ps7_init: it also changes CPU, DDR, PLL and peripheral settings.
proc read32 {address} {
    return [lindex [mrd -value $address] 0]
}

proc masked_write32 {address mask value} {
    set previous [read32 $address]
    mwr $address [expr {($previous & (~$mask & 0xffffffff)) | ($value & $mask)}]
}

connect -url tcp:127.0.0.1:3121
targets -set -filter {name =~ "APU"}

set pll_ctrl [read32 0xF8000108]
set pll_status [read32 0xF800010C]
set boot_mode [read32 0xF800025C]
set clock_before [read32 0xF8000170]
set throttle_before [read32 0xF8000178]
set reset_before [read32 0xF8000240]
set shifters_before [read32 0xF8000900]
set lock_before [expr {[read32 0xF800000C] & 1}]

# 50 MHz PS crystal times PLL feedback divider 20 = 1 GHz.
if {(($pll_ctrl >> 12) & 0x7f) != 20 ||
    ($pll_ctrl & 0x13) != 0 ||
    (($pll_ctrl & 8) != 0 && ($boot_mode & 16) != 0) ||
    ($pll_status & 4) == 0} {
    error "Expected a locked, non-bypassed 1 GHz IO PLL; PS settings were not changed."
}
if {($reset_before & 1) != 0 || ($shifters_before & 0xf) != 0xf} {
    error "PS/PL interface is not initialized; PS settings were not changed."
}
if {$throttle_before != 0} {
    error "FCLK0 is not in the expected continuous-clock mode; PS settings were not changed."
}

set clock_mask 0x03F03F30
# Use the exact divider encoding generated by this diagnostic's PS7 IP:
# IO PLL / DIVISOR0=4 / DIVISOR1=2 = 125 MHz.
set clock_value 0x00200400
puts [format "FCLK0_BEFORE: 0x%08X" $clock_before]

if {($clock_before & $clock_mask) != $clock_value} {
    try {
        if {$lock_before} {
            mwr 0xF8000008 0x0000DF0D
        }
        masked_write32 0xF8000178 1 1
        masked_write32 0xF8000170 $clock_mask $clock_value
        masked_write32 0xF8000178 1 0
        if {([read32 0xF8000170] & $clock_mask) != $clock_value ||
            ([read32 0xF8000178] & 1) != 0} {
            error "FCLK0 configuration readback failed."
        }
    } on error {message options} {
        catch {masked_write32 0xF8000178 1 1}
        catch {mwr 0xF8000170 $clock_before}
        catch {mwr 0xF8000178 $throttle_before}
        return -options $options $message
    } finally {
        if {$lock_before} {
            mwr 0xF8000004 0x0000767B
        }
    }
}

puts [format "FCLK0_AFTER: 0x%08X" [read32 0xF8000170]]
puts "AUDIO_FCLK_CONFIG_SUCCESS: 125 MHz; CPU, DDR, PLL and MIO settings preserved."
disconnect
