[Unit]
Description=FretLens USB camera video service
After=network.target

[Service]
Type=simple
User=xilinx
SupplementaryGroups=video
WorkingDirectory=/home/xilinx
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStartPre=+/usr/bin/python3 /home/xilinx/keep_camera_awake.py
ExecStart=/usr/bin/python3 -u -B /home/xilinx/vision_server.py --camera 0 --host 0.0.0.0 --port 8082 --max-width 640 --max-height 480 --fps 30 --jpeg-quality 70
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
